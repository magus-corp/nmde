#!/bin/bash

DB_FILE="$HOME/.local/share/nmde/composes/env_files/envs.db"

# Function to list services
list_services() {
  sqlite3 "$DB_FILE" "SELECT DISTINCT service FROM envs ORDER BY service;"
}

# Function to list variables for a service
list_vars() {
  local service=$1
  # The { } brackets are essential to prevent syntax errors if a service has no envs
  sqlite3 "$DB_FILE" "SELECT key, value FROM envs WHERE service = '$service' ORDER BY key;" | {
    while IFS='|' read -r key value; do
      printf "% -40s = %s\n" "$key" "$value"
    done
  }
}

# Function to add or edit a variable
edit_var() {
  local service=$1
  local key=$(gum input --placeholder "Variable Name")
  [ -z "$key" ] && return
  
  local current_value=$(sqlite3 "$DB_FILE" "SELECT value FROM envs WHERE service = '$service' AND key = '$key';")
  local new_value=$(gum input --placeholder "Variable Value" --value "$current_value")

  sqlite3 "$DB_FILE" "INSERT OR REPLACE INTO envs (service, key, value) VALUES ('$service', '$key', '$new_value');"
}

# Function to delete a variable
delete_var() {
  local service=$1
  local var_to_delete=$(sqlite3 "$DB_FILE" "SELECT key FROM envs WHERE service = '$service' ORDER BY key;" | gum choose)
  [ -z "$var_to_delete" ] && return

  if gum confirm "Delete '$var_to_delete' from '$service'?"; then
    sqlite3 "$DB_FILE" "DELETE FROM envs WHERE service = '$service' AND key = '$var_to_delete';"
  fi
}

# Service menu
service_menu() {
  local service=$1
  while true; do
    clear
    gum style --border normal --margin "1" --padding "1" "Managing Environment for: $service"
    list_vars "$service"
    
    local choice=$(gum choose "Edit/Add Variable" "Delete Variable" "Back")

    case "$choice" in
      "Edit/Add Variable") edit_var "$service" ;; 
      "Delete Variable") delete_var "$service" ;; 
      "Back" | "") break ;; 
    esac
  done
}

# Main menu
main_menu() {
  # If a service is passed as an argument, go directly to its menu
  if [ -n "$1" ]; then
    service_menu "$1"
    exit 0
  fi

  while true; do
    clear
    local service=$(list_services | gum choose --height 20 --header "Select a service to manage")
    
    if [ -n "$service" ]; then
      service_menu "$service"
    else
      break # Exit if user presses escape
    fi
  done
}

main_menu "$1"
