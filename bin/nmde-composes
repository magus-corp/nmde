#!/bin/bash

COMPOSE_DIR="$HOME/.local/share/nmde/composes"
STATE_FILE="$COMPOSE_DIR/.state"
ENV_DIR="$COMPOSE_DIR/env_files"
DB_FILE="$ENV_DIR/envs.db"

# Function to check for dependencies
check_dependencies() {
  if ! command -v gum &> /dev/null; then echo "gum not found" >&2; exit 1; fi
  if ! command -v yq &> /dev/null; then echo "yq not found" >&2; exit 1; fi
  if ! command -v sqlite3 &> /dev/null; then echo "sqlite3 not found" >&2; exit 1; fi
}

# Function to generate .env file for a service
generate_env_file() {
  local service_name=$1
  local env_file_path="$ENV_DIR/$service_name.env"
  
  # Clear existing file and add a header
  echo "# Auto-generated by nmde-composes on $(date)" > "$env_file_path"
  
  sqlite3 "$DB_FILE" "SELECT key, value FROM envs WHERE service = '$service_name';" | while IFS='|' read -r key value; do
    # Simply wrap in quotes. Docker compose handles expansion.
    echo "$key=$value" >> "$env_file_path"
  done
}

# Function to get the list of compose files
get_compose_files() {
  find "$COMPOSE_DIR" -maxdepth 1 -type f \( -name "*.yaml" -o -name "*.yml" \) -exec basename {} \; | sort
}

# Function to get the list of "up" services from the state file
get_up_services() {
  [ -f "$STATE_FILE" ] && cat "$STATE_FILE"
}

# Function to toggle a service's state
toggle_service() {
  local service_to_toggle=$1
  local up_services=($(get_up_services))
  local new_up_services=()
  local found=false

  for service in "${up_services[@]}"; do
    if [[ "$service" == "$service_to_toggle" ]]; then
      found=true
    else
      new_up_services+=("$service")
    fi
  done

  if ! $found; then
    new_up_services+=("$service_to_toggle")
  fi

  printf "%s\n" "${new_up_services[@]}" | sort > "$STATE_FILE"
}

# Function to sync the compose files
sync_composes() {
  local up_services=($(get_up_services))
  
  # First, generate all necessary .env files
  for service_file in "${up_services[@]}"; do
    local service_name=$(basename "$service_file" .yaml | sed 's/.yml//')
    generate_env_file "$service_name"
  done

  echo "Bringing up selected services..."
  for service_file in "${up_services[@]}"; do
    local service_name=$(basename "$service_file" .yaml | sed 's/.yml//')
    local env_file_path="$ENV_DIR/$service_name.env"
    docker-compose -f "$COMPOSE_DIR/$service_file" --env-file "$env_file_path" up -d --remove-orphans
  done
  
  echo "Shutting down deselected services..."
  all_compose_files=($(get_compose_files))
  for service_file in "${all_compose_files[@]}"; do
    if [[ ! " ${up_services[@]} " =~ " ${service_file} " ]]; then
      # Check if it was running before to avoid unnecessary commands
      if [ -f "$COMPOSE_DIR/.pre_sync_state" ] && grep -q "$service_file" "$COMPOSE_DIR/.pre_sync_state"; then
         docker-compose -f "$COMPOSE_DIR/$service_file" down --remove-orphans
      fi
    fi
  done
}

main_menu() {
  check_dependencies
  cp "$STATE_FILE" "$COMPOSE_DIR/.pre_sync_state" 2>/dev/null || touch "$COMPOSE_DIR/.pre_sync_state"

  while true; do
    local compose_files=($(get_compose_files))
    local up_services=($(get_up_services))
    local choices=()

    for file in "${compose_files[@]}"; do
      if [[ " ${up_services[@]} " =~ " ${file} " ]]; then
        choices+=("✓ $file")
      else
        choices+=("  $file")
      fi
    done

    choices+=("")
    choices+=("[Sync and Exit]")
    choices+=("[Cancel]")

    choice=$(printf "%s\n" "${choices[@]}" | gum choose --height 20 --header "Select a service to open its menu.")
    
    if [ -z "$choice" ]; then
      choice="[Cancel]"
    fi

    case "$choice" in
      "[Sync and Exit]")
        sync_composes
        gum spin --spinner "globe" --title "Sync complete!" -- sleep 1
        break
        ;;
      "[Cancel]")
        mv "$COMPOSE_DIR/.pre_sync_state" "$STATE_FILE" 2>/dev/null || rm -f "$STATE_FILE"
        break
        ;;
      "")
        ;;
      *)
        service_file=$(echo "$choice" | sed -e 's/✓ //' -e 's/  //')
        service_name=$(basename "$service_file" .yaml | sed 's/.yml//')
        
        sub_choice=$(gum choose "Toggle On/Off" "Edit Environment")
        case "$sub_choice" in
          "Toggle On/Off")
            toggle_service "$service_file"
            ;;
          "Edit Environment")
            nmde-env "$service_name"
            ;;
        esac
        ;;
    esac
  done
  
  rm -f "$COMPOSE_DIR/.pre_sync_state"
}

main_menu