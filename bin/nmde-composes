#!/bin/bash

COMPOSE_DIR="$HOME/.local/share/nmde/composes"
STATE_FILE="$COMPOSE_DIR/.state"

# Function to check for dependencies
check_dependencies() {
  if ! command -v gum &> /dev/null;
  then
    echo "gum could not be found. Please install it."
    exit 1
  fi
  if ! command -v yq &> /dev/null;
  then
    echo "yq could not be found. Please install it."
    exit 1
  fi
}

# Function to check for port conflicts
check_ports() {
  local compose_files=($@)
  local all_ports=()
  local has_conflict=false

  for file in "${compose_files[@]}"; do
    ports=$(yq e '.services.*.ports[].published' "$COMPOSE_DIR/$file" 2>/dev/null)
    for port in $ports; do
      if [[ " ${all_ports[@]} " =~ " ${port} " ]]; then
        gum confirm "Port conflict found for port $port in $file. Continue?" || exit 1
        has_conflict=true
      else
        all_ports+=("$port")
      fi
    done
  done
}

# Function to get the list of compose files
get_compose_files() {
  find "$COMPOSE_DIR" -maxdepth 1 -type f \( -name "*.yaml" -o -name "*.yml" \) -exec basename {} \;
}

# Function to get the list of up compose files
get_up_files() {
  if [ -f "$STATE_FILE" ]; then
    cat "$STATE_FILE"
  fi
}

# Function to show the main menu
main_menu() {
  check_dependencies
  
  local compose_files=($(get_compose_files))
  local up_files=($(get_up_files))
  
  # Pre-select the files that are already up
  local selected_options=""
  for file in "${compose_files[@]}"; do
    if [[ " ${up_files[@]} " =~ " ${file} " ]]; then
      if [ -z "$selected_options" ]; then
        selected_options="$file"
      else
        selected_options="$selected_options,$file"
      fi
    fi
  done

  gum style --border normal --margin "1" --padding "1" --border-foreground 212 "Select services to run with <space>. Press <enter> to sync."

  selected=$(gum choose --no-limit --selected="$selected_options" "${compose_files[@]}")

  if [ -n "$selected" ]; then
    local selected_files=()
    while IFS= read -r line; do
      selected_files+=("$line")
    done <<< "$selected"
    
    check_ports "${selected_files[@]}"
    sync_composes "${selected_files[@]}"
  else
    # If nothing is selected, it means all services should be down
    sync_composes
  fi
  
  gum spin --spinner "globe" --title "Done!" -- sleep 1
}

# Function to sync the compose files
sync_composes() {
  local selected_files=($@)
  local up_files=($(get_up_files))

  # Bring up selected files
  for file in "${selected_files[@]}"; do
    if [[ ! " ${up_files[@]} " =~ " ${file} " ]]; then
      echo "Bringing up $file"
      docker-compose -f "$COMPOSE_DIR/$file" up -d
    fi
  done

  # Bring down unselected files
  for file in "${up_files[@]}"; do
    if [[ ! " ${selected_files[@]} " =~ " ${file} " ]]; then
      echo "Bringing down $file"
      docker-compose -f "$COMPOSE_DIR/$file" down
    fi
  done

  # Update state file
  if [ ${#selected_files[@]} -gt 0 ]; then
    printf "%s\n" "${selected_files[@]}" > "$STATE_FILE"
  else
    rm -f "$STATE_FILE"
  fi
}

main_menu
