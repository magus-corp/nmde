#!/bin/bash

COMPOSE_DIR="$HOME/.local/share/nmde/composes"
STATE_FILE="$COMPOSE_DIR/.state"
DB_FILE="$COMPOSE_DIR/envs.db"
ENV_DIR="$COMPOSE_DIR/env_files"

# Function to check for dependencies
check_dependencies() {
  if ! command -v gum &> /dev/null; then echo "gum not found" >&2; exit 1; fi
  if ! command -v yq &> /dev/null; then echo "yq not found" >&2; exit 1; fi
  if ! command -v sqlite3 &> /dev/null; then echo "sqlite3 not found" >&2; exit 1; fi
}

# Function to generate .env file for a service
generate_env_file() {
  local service=$1
  local env_file_path="$ENV_DIR/$service.env"
  
  # Clear existing file
  > "$env_file_path"
  
  sqlite3 "$DB_FILE" "SELECT key, value FROM envs WHERE service = '$service';" | while IFS='|' read -r key value; do
    echo "$key=$value" >> "$env_file_path"
  done
}

# Function to check for port conflicts
check_ports() {
  local compose_files=($@)
  # ... (rest of the function remains the same)
}

# Function to get the list of compose files
get_compose_files() {
  find "$COMPOSE_DIR" -maxdepth 1 -type f \( -name "*.yaml" -o -name "*.yml" \) -exec basename {} \; | sort
}

# Function to get the list of up compose files
get_up_files() {
  [ -f "$STATE_FILE" ] && cat "$STATE_FILE"
}

# Function to sync the compose files
sync_composes() {
  local selected_files_basenames=($@)
  local up_files_basenames=($(get_up_files))

  # Generate .env files for all selected services first
  for basename in "${selected_files_basenames[@]}"; do
    local service_name=$(echo "$basename" | sed -e 's/.yaml//' -e 's/.yml//')
    generate_env_file "$service_name"
  done

  gum spin --spinner dot --title "Syncing services..." --show-output -- bash -c "
    set -e
    # Bring up selected files
    for basename in ${selected_files_basenames[@]}; do
      if [[ ! \" ${up_files_basenames[@]} \" =~ \" ${basename} \" ]]; then
        echo \"Bringing up \$basename...\"
        docker-compose -f \"$COMPOSE_DIR/\$basename\" --env-file \"$ENV_DIR/\$(echo \$basename | sed -e 's/.yaml/.env/' -e 's/.yml/.env/)\" up -d
      fi
    done

    # Bring down unselected files
    for basename in ${up_files_basenames[@]}; do
      if [[ ! \" ${selected_files_basenames[@]} \" =~ \" ${basename} \" ]]; then
        echo \"Bringing down \$basename...\"
        docker-compose -f \"$COMPOSE_DIR/\$basename\" down --remove-orphans
      fi
    done
  "
  
  # Update state file
  printf "%s\n" "${selected_files_basenames[@]}" > "$STATE_FILE"
}

main_menu() {
  check_dependencies
  
  local compose_files=($(get_compose_files))
  local up_files=($(get_up_files))
  
  local selected_options=""
  for file in "${compose_files[@]}"; do
    if [[ " ${up_files[@]} " =~ " ${file} " ]]; then
      selected_options="$selected_options,$file"
    fi
  done
  # Remove leading comma if it exists
  [[ -n "$selected_options" ]] && selected_options=${selected_options:1}

  gum style --border normal --margin "1" --padding "1" --border-foreground 212 "Select services to run with <space>. Press <enter> to sync."

  selected=$(gum choose --no-limit --selected="$selected_options" "${compose_files[@]}")

  if [ -n "$selected" ]; then
    local new_selected_files=()
    while IFS= read -r line; do
      new_selected_files+=("$line")
    done <<< "$selected"
    
    # check_ports "${new_selected_files[@]}" # Port checking can be added back if needed
    sync_composes "${new_selected_files[@]}"
  else
    sync_composes # Sync with empty selection to bring everything down
  fi
  
  gum spin --spinner "globe" --title "Done!" -- sleep 1
}

main_menu
