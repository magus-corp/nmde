#!/bin/bash

COMPOSE_DIR="$HOME/.local/share/nmde/composes"
STATE_FILE="$COMPOSE_DIR/.state"

# Function to check for port conflicts
check_ports() {
  local compose_files=($(get_compose_files))
  local all_ports=()
  local has_conflict=false

  for file in "${compose_files[@]}"; do
    ports=$(yq e '.services.*.ports[]?' "$COMPOSE_DIR/$file" 2>/dev/null)
    for port in $ports; do
      host_port=$(echo "$port" | cut -d: -f1)
      if [[ " ${all_ports[@]} " =~ " ${host_port} " ]]; then
        echo "Port conflict found for port $host_port in $file"
        has_conflict=true
      else
        all_ports+=("$host_port")
      fi
    done
  done

  if [ "$has_conflict" = true ]; then
    exit 1
  fi
}

# Function to get the list of compose files
get_compose_files() {
  find "$COMPOSE_DIR" -maxdepth 1 -type f \( -name "*.yaml" -o -name "*.yml" \) -exec basename {} \;
}

# Function to get the list of up compose files
get_up_files() {
  if [ -f "$STATE_FILE" ]; then
    cat "$STATE_FILE"
  fi
}

# Function to show the main menu
main_menu() {
  check_ports

  local compose_files=($(get_compose_files))
  local up_files=($(get_up_files))
  local choices=()

  for file in "${compose_files[@]}"; do
    if [[ " ${up_files[@]} " =~ " ${file} " ]]; then
      choices+=("✓ $file")
    else
      choices+=("  $file")
    fi
  done

  selected=$(printf "%s\n" "${choices[@]}" "Sync" | gum choose --no-limit --header "Select compose files to run")

  if [ -n "$selected" ]; then
    if [[ "$selected" == "Sync" ]]; then
      local selected_files=()
      for choice in "${choices[@]}"; do
        if [[ "$choice" == ✓* ]]; then
          selected_files+=("$(echo "$choice" | sed 's/✓ //g' | xargs)")
        fi
      done
      sync_composes "${selected_files[@]}"
    else
        local selected_files=()
        while IFS= read -r line; do
          selected_files+=("$(echo "$line" | sed 's/✓ //g' | xargs)")
        done <<< "$selected"
        update_selection "${selected_files[@]}"
    fi
  fi
}

update_selection() {
    local selected_files=($@)
    local compose_files=($(get_compose_files))
    local choices=()

    for file in "${compose_files[@]}"; do
        if [[ " ${selected_files[@]} " =~ " ${file} " ]]; then
        choices+=("✓ $file")
        else
        choices+=("  $file")
        fi
    done
    
    selected=$(printf "%s\n" "${choices[@]}" "Sync" | gum choose --no-limit --header "Select compose files to run")

    if [ -n "$selected" ]; then
        if [[ "$selected" == "Sync" ]]; then
            sync_composes "${selected_files[@]}"
        else
            local new_selected_files=()
            while IFS= read -r line; do
                new_selected_files+=("$(echo "$line" | sed 's/✓ //g' | xargs)")
            done <<< "$selected"
            update_selection "${new_selected_files[@]}"
        fi
    fi
}


# Function to sync the compose files
sync_composes() {
  local selected_files=($@)
  local up_files=($(get_up_files))

  # Bring up selected files
  for file in "${selected_files[@]}"; do
    if [[ ! " ${up_files[@]} " =~ " ${file} " ]]; then
      echo "Bringing up $file"
      # docker-compose -f "$COMPOSE_DIR/$file" up -d
    fi
  done

  # Bring down unselected files
  for file in "${up_files[@]}"; do
    if [[ ! " ${selected_files[@]} " =~ " ${file} " ]]; then
      echo "Bringing down $file"
      # docker-compose -f "$COMPOSE_DIR/$file" down
    fi
  done

  # Update state file
  printf "%s\n" "${selected_files[@]}" > "$STATE_FILE"
}

main_menu