#!/bin/bash

DB_FILE="$HOME/.local/share/nmde/composes/env_files/envs.db"
ENV_DIR="$HOME/.local/share/nmde/composes/env_files"

if gum confirm "This will delete the existing environment database and rebuild it from the example files. Are you sure?"; then
  # Delete the old database
  rm -f "$DB_FILE"
  echo "Old database removed."

  # Create the database and table
  sqlite3 "$DB_FILE" "CREATE TABLE IF NOT EXISTS envs (service TEXT, key TEXT, value TEXT, PRIMARY KEY(service, key));"
  echo "New database created."

  # Find all example env files
  find "$ENV_DIR" -name "example.*.env" | while read -r example_file;
  do
    service_name=$(basename "$example_file" | sed -e 's/example.//' -e 's/.env//')
    
    echo "Migrating $service_name..."

    # Read each line, ignore comments and empty lines
    grep -vE '^\s*#|^\s*$' "$example_file" | while IFS='=' read -r key value;
    do
      # Trim leading/trailing whitespace
      key=$(echo "$key" | xargs)
      value=$(echo "$value" | xargs)
      
      # Remove quotes from value if present
      value=\"${value}\" # This line was problematic, it should be value="${value}"
      value=\"${value}\" # This line was problematic, it should be value="${value}"

      # Insert into database
      sqlite3 "$DB_FILE" "INSERT OR REPLACE INTO envs (service, key, value) VALUES ('$service_name', '$key', '$value');"
    done
  done

  gum spin --spinner "globe" --title "Database rebuild complete!" -- sleep 1
else
  echo "Rebuild cancelled."
fi
